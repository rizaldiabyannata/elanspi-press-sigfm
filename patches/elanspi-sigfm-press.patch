           break;
         }
     }
@@ -1359,6 +1365,31 @@ elanspi_fp_frame_stitch_and_submit (FpiDeviceElanSpi *self)
   g_slist_free_full (g_steal_pointer (&self->fp_frame_list), g_free);
 }
 
+/* stitching near-identical frames from a press sensor destroys the image, so submit one frame as-is */
+static void
+elanspi_fp_frame_press_submit (FpiDeviceElanSpi *self)
+{
+  g_autoptr(FpImage) img = fp_image_new (self->frame_width, self->frame_height);
+  g_autoptr(FpImage) scaled = NULL;
+  /* list is prepended, so the head holds the newest, most settled frames; averaging them cuts sensor noise */
+  guint n = MIN (g_slist_length (self->fp_frame_list), ELANSPI_PRESS_AVG_FRAMES);
+
+  for (int px = 0; px < self->frame_width * self->frame_height; px++)
+    {
+      guint sum = 0;
+      GSList *l = self->fp_frame_list;
+      for (guint i = 0; i < n; i++, l = l->next)
+        sum += ((struct fpi_frame *) l->data)->data[px];
+      img->data[px] = sum / n;
+    }
+  scaled = fpi_image_resize (img, 2, 2);
+  scaled->flags |= FPI_IMAGE_COLORS_INVERTED;
+
+  fpi_image_device_image_captured (FP_IMAGE_DEVICE (self), g_steal_pointer (&scaled));
+
+  g_slist_free_full (g_steal_pointer (&self->fp_frame_list), g_free);
+}
+
